def apply_colormap(gray, colormap=cv2.COLORMAP_JET):
    return cv2.applyColorMap(gray, colormap)

def color_balance(img):
    b, g, r = cv2.split(img.astype(np.float32))
    b_mean, g_mean, r_mean = b.mean(), g.mean(), r.mean()
    gray_mean = (b_mean + g_mean + r_mean) / 3.0
    b = b * (gray_mean / (b_mean + 1e-6))
    g = g * (gray_mean / (g_mean + 1e-6))
    r = r * (gray_mean / (r_mean + 1e-6))
    return np.clip(cv2.merge([b, g, r]), 0, 255).astype(np.uint8)

def threshold_mask(gray, thresh_val=200):
    _, mask = cv2.threshold(gray, thresh_val, 255, cv2.THRESH_BINARY)
    return mask

def log_transform(img):
    img_f = img.astype(np.float32)
    c = 255.0 / np.log(1 + np.max(img_f))
    return np.clip(c * np.log(1 + img_f), 0, 255).astype(np.uint8)

def gamma_transform(img, gamma=0.5):
    img_f = img.astype(np.float32) / 255.0
    return np.clip(np.power(img_f, gamma) * 255.0, 0, 255).astype(np.uint8)
